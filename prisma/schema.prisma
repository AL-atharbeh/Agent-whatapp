// منصة "وكيل" — وكيل ذكاء اصطناعي لخدمة عملاء البزنسات الصغيرة والمتوسطة.
//
// مبدأ العزل: كل جدول يحمل tenantId، وكل استعلام يمر عبر طبقة النطاق
// (src/lib/tenancy.ts) التي تحقن tenantId إجبارياً. لا يوجد أي مسار في الكود
// يقرأ بيانات عميل بدون تحديد العميل.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // DATABASE_URL: عبر الـ pooler (منفذ 6543) — للتشغيل العادي
  url       = env("DATABASE_URL")
  // DIRECT_URL: اتصال مباشر (منفذ 5432) — يحتاجه Prisma لتطبيق السكيما
  directUrl = env("DIRECT_URL")
}

// ═══════════════════════════════════════════════════════════
//  المستخدمون
// ═══════════════════════════════════════════════════════════

enum UserRole {
  PLATFORM_ADMIN // مالك المنصة — يرى كل العملاء ويدير القنوات
  TENANT_OWNER   // صاحب المتجر — يرى متجره فقط
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         UserRole @default(TENANT_OWNER)

  // فارغ لمالك المنصة؛ إجباري فعلياً لصاحب المتجر — العزل يعتمد عليه
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())

  /**
   * بداية «غير المقروء» لهذا المستخدم — أول دخول له من الجوال.
   *
   * بدونها كل رسالة سبقت أول دخول تُعدّ غير مقروءة: يفتح صاحب المتجر التطبيق
   * أول مرة فيجد أربعمئة رسالة «جديدة» من شهور، فيتعلّم من اليوم الأول أن
   * العدّاد لا يعني شيئاً — وهو العدّاد الذي بُني ليقول له أين ينظر.
   * والمحادثات المحوّلة له لا تتأثر: عدّادها الأحمر من الحالة لا من القراءة.
   */
  inboxBaselineAt DateTime?

  devices DeviceSession[]
  reads   ConversationRead[]

  @@index([tenantId])
}

/**
 * جلسة جهاز جوال — صفّ قابل للسحب، لا توقيع بلا حالة.
 *
 * جلسة الويب توقيع HMAC لا يُسحب إلا بتغيير مفتاح المنصة كلها. مقبول
 * لمتصفح على مكتب، وغير مقبول لجوال قد يُسرَق أو يُباع: صاحب المتجر يحتاج
 * أن يُخرج ذلك الجهاز وحده الآن، لا أن ينتظر ثلاثين يوماً.
 *
 * نخزّن هاش SHA-256 للرمز فقط: تسريب القاعدة لا يعطي رمزاً صالحاً.
 * انظر docs/mobile-api.md.
 */
model DeviceSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // نسخة من User.tenantId لحظة الدخول — يُقارَن بها في كل طلب، فنقل
  // المستخدم لمتجر آخر يُبطل جلساته بدل أن يفتح له بيانات المتجرين.
  tenantId String

  tokenHash String @unique
  name      String
  platform  String // ios | android

  pushToken String?
  notify    String  @default("all") // all | handoff | off

  createdAt         DateTime  @default(now())
  lastSeenAt        DateTime  @default(now())
  expiresAt         DateTime // منزلقة: ٣٠ يوماً من آخر استخدام
  absoluteExpiresAt DateTime // سقف مطلق: ٩٠ يوماً من الإنشاء — لا يمدّده الاستخدام
  revokedAt         DateTime?

  @@index([tenantId])
  @@index([userId])
  @@index([pushToken])
}

/**
 * محاولات الدخول — عدّاد تحديد المعدّل.
 *
 * في القاعدة لا في الذاكرة: Vercel يشغّل نسخاً متعددة لا تشترك في ذاكرتها،
 * فعدّاد محلي يعطي المهاجم خمس محاولات لكل نسخة بدل خمس إجمالاً.
 */
model LoginAttempt {
  id        String   @id @default(cuid())
  key       String // البريد بعد التوحيد
  success   Boolean
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════
//  العميل (البزنس المشترك) — جذر العزل
// ═══════════════════════════════════════════════════════════

enum TenantStatus {
  ACTIVE
  PAUSED
  SUSPENDED
}

/**
 * الباقات — يديرها مالك المنصة من اللوحة.
 *
 * كل حد هنا يُطبَّق فعلياً وقت التفعيل ووقت معالجة الرسائل، لا مجرد نص
 * تسويقي: تجاوز سقف الردود يوقف الرد، وقناة خارج الباقة تُرفض قبل النموذج.
 */
model Plan {
  id      String  @id @default(cuid())
  tier    String  @unique // معرّف ثابت يُخزَّن في Tenant.plan
  name    String
  tagline String?

  monthlyPrice Decimal @db.Decimal(10, 2)

  channels         String[] // WHATSAPP | MESSENGER | INSTAGRAM | WEB | VOICE
  maxRepliesPerDay Int      @default(200)

  /**
   * سقف الردود في الدقيقة — حماية من الاندفاع.
   * السقف اليومي وحده لا يمنع استهلاكه كاملاً في دقيقة واحدة، وهو ما يرفع
   * الكلفة فجأة ويضغط على حدود المزوّد.
   */
  maxRepliesPerMinute Int @default(20)
  maxProducts      Int      @default(500)

  // إعدادات النموذج التي تُطبَّق على متاجر هذه الباقة
  modelId String @default("claude-sonnet-5")
  effort  String @default("low")

  features  String[]
  highlight Boolean @default(false)
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

enum SubscriptionStatus {
  NONE      // سجّل ولم يطلب باقة بعد
  REQUESTED // اختار باقة وينتظر تفعيل مالك المنصة
  ACTIVE    // مفعّل ويعمل
  EXPIRED   // انتهت المدة
  CANCELLED
}

model Tenant {
  id           String       @id @default(cuid())
  slug         String       @unique // يستخدم في رابط الويبهوك: /api/webhooks/meta/<slug>
  name         String
  businessType String // gold | clothing | restaurant | pharmacy | clinic | realestate | other
  status       TenantStatus @default(ACTIVE)

  locale   String @default("ar-JO") // لغة/لهجة الرد
  timezone String @default("Asia/Amman")
  currency String @default("JOD")

  // ── الاشتراك ──
  // الباقة تحدد الحدود المطبَّقة فعلياً (القنوات، سقف الردود، النموذج) —
  // انظر src/lib/plans.ts. الطلب من العميل، والتفعيل من مالك المنصة.
  plan               String?            // STARTER | GROWTH | BUSINESS
  requestedPlan      String?            // ما اختاره العميل وينتظر تفعيله
  subscription       SubscriptionStatus @default(NONE)
  monthlyPrice       Decimal?           @db.Decimal(10, 2)
  requestedAt        DateTime?
  activatedAt        DateTime?
  expiresAt          DateTime?
  billingNote        String?            @db.Text // ملاحظة داخلية لمالك المنصة

  // ── إعدادات شخصية الوكيل ──
  agentName        String  @default("المساعد")
  tone             String  @default("ودّي ومهذب، جمل قصيرة، بدون مبالغة")
  modelId          String  @default("claude-opus-5")
  effort           String  @default("low") // low | medium | high | xhigh | max
  customPolicy     String? @db.Text // تعليمات إضافية يكتبها صاحب البزنس
  handoffKeywords  String[] @default([]) // كلمات تفرض التحويل لموظف بشري فوراً
  maxRepliesPerDay Int      @default(2000) // سقف حماية من الاستنزاف
  maxRepliesPerMinute Int  @default(60)  // سقف الاندفاع — يُنسخ من الباقة عند التفعيل

  /**
   * الرد بفويس على من يرسل فويس. الفويس الوارد يُفرَّغ دائماً بلا إعداد —
   * أما الرد المنطوق فله كلفة لكل رسالة، فيبقى اختيار صاحب المتجر.
   */
  voiceReplies Boolean @default(false)

  /**
   * سرّ يصادق منصة المكالمات على نقطة الوكيل الصوتية.
   * بدونه يقدر أي أحد يشغّل وكيلك ويصرف رصيدك — فالنقطة عامة بالضرورة.
   */
  voiceToken String? @unique

  /**
   * رقم المكالمات (E.164) — به يعرف حاضر لأي متجر مكالمةٌ تصله منصة المكالمات.
   * منصة واحدة ومساعد واحد للمنصة كلها؛ ما يميّز متجراً عن آخر هو الرقم المطلوب.
   */
  voicePhone String? @unique
  /// { voiceId, voiceName, voiceModel, firstMessage, vapiPhoneNumberId } — lib/voice/settings.ts
  voiceSettings Json?

  /**
   * وحدة المواعيد — اختيارية لأي نشاط بالمواعيد (عيادة، صالون، مركز صيانة…)،
   * يفعّلها مالك المنصة لمتجر بعينه.
   * بدونها لا أدوات حجز للوكيل ولا صفحات ولا مهام مجدولة: متجر ذهب لا
   * يدفع ثمن تعريفات أدوات لا يستعملها في كل رسالة.
   * انظر docs/appointments.md.
   */
  appointmentsEnabled Boolean @default(false)
  /// { slotStepMinutes, bufferMinutes, reminderHour, … } — الافتراضيات في lib/appointments/settings.ts
  appointmentSettings Json?

  profile       BusinessProfile?
  products      Product[]
  faqs          Faq[]
  dataSources   DataSource[]
  channels      ChannelAccount[]
  conversations Conversation[]
  leads         Lead[]
  users         User[]

  services     Service[]
  staff        Staff[]
  customers    Customer[]
  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BusinessProfile {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  about          String? @db.Text
  address        String?
  mapsUrl        String?
  phone          String?
  workingHours   String? // "السبت–الخميس ١٠ص–١٠م، الجمعة مغلق"
  deliveryPolicy String? @db.Text
  returnPolicy   String? @db.Text
  paymentMethods String?
  websiteUrl     String?

  updatedAt DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════
//  المعرفة: الكتالوج + الأسئلة الشائعة
// ═══════════════════════════════════════════════════════════

model Product {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  sku         String?
  name        String
  description String? @db.Text
  category    String?

  price     Decimal? @db.Decimal(12, 3)
  priceUnit String   @default("piece") // piece | gram | kg | hour | night
  currency  String?

  inStock  Boolean @default(true)
  quantity Int?

  // خصائص حرة حسب نوع البزنس:
  // ذهب: { "karat": 21, "weight_g": 12.5, "workmanship_per_g": 3 }
  // ملابس: { "sizes": ["S","M","L"], "colors": ["أزرق","أسود"] }
  attributes Json?

  imageUrl String?
  active   Boolean @default(true)

  // نص مُطبّع للبحث العربي (بدون تشكيل، وتوحيد الألف/الهمزة/التاء المربوطة)
  searchText String @default("")

  updatedAt DateTime @updatedAt

  @@unique([tenantId, sku])
  @@index([tenantId, active])
  @@index([tenantId, category])
}

model Faq {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  question String  @db.Text
  answer   String  @db.Text
  priority Int     @default(0)
  active   Boolean @default(true)

  @@index([tenantId, active])
}

// ═══════════════════════════════════════════════════════════
//  مصادر البيانات الحيّة (سعر الذهب، مخزون خارجي، ...)
// ═══════════════════════════════════════════════════════════

enum DataSourceKind {
  MANUAL // قيمة يحدّثها صاحب البزنس من اللوحة (الأنسب لسعر الذهب اليومي)
  HTTP_JSON // جلب من API خارجي
}

model DataSource {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  key         String // معرّف يستخدمه الوكيل، مثل: "gold_price"
  label       String // وصف بالعربية يظهر للوكيل: "أسعار الذهب اليوم"
  kind        DataSourceKind @default(MANUAL)
  config      Json? // HTTP_JSON: { "url": "...", "headers": {...} }
  value       Json? // آخر قيمة معروفة
  valueAt     DateTime?
  staleAfterMinutes Int @default(720) // بعدها تُعتبر القيمة قديمة ولا يُصرّح بها
  active      Boolean @default(true)

  @@unique([tenantId, key])
}

// ═══════════════════════════════════════════════════════════
//  القنوات
// ═══════════════════════════════════════════════════════════

enum Channel {
  WHATSAPP
  MESSENGER
  INSTAGRAM
  WEB
  VOICE // مكالمة صوتية عبر منصة مكالمات خارجية
}

model ChannelAccount {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  channel Channel

  // WHATSAPP: phone_number_id | MESSENGER: page_id | INSTAGRAM: ig_account_id
  externalId String

  // WHATSAPP فقط: معرّف حساب واتساب التجاري — يُستخدم لاشتراك التطبيق فيه
  wabaId String?

  // آخر اشتراك ناجح للتطبيق في أصل القناة عند Meta
  subscribedAt DateTime?

  // مشفّرة بـ AES-256-GCM قبل التخزين (src/lib/crypto.ts)
  accessTokenEnc String? @db.Text
  appSecretEnc   String? @db.Text
  verifyToken    String?

  displayName String?
  active      Boolean @default(true)

  @@unique([channel, externalId]) // يمنع ربط نفس الرقم/الصفحة بأكثر من عميل
  @@index([tenantId])
}

// ═══════════════════════════════════════════════════════════
//  المحادثات
// ═══════════════════════════════════════════════════════════

enum ConversationStatus {
  BOT // الوكيل يرد
  HUMAN // محوّلة لموظف بشري — الوكيل صامت
  CLOSED
}

enum MessageRole {
  USER
  AGENT
  HUMAN
  SYSTEM
}

model Conversation {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  channel        Channel
  externalUserId String // رقم واتساب العميل أو PSID
  customerName   String?

  status        ConversationStatus @default(BOT)
  handoffReason String?            @db.Text
  handoffAt     DateTime?

  messages  Message[]
  reads     ConversationRead[]
  createdAt DateTime  @default(now())
  lastMessageAt DateTime @default(now())

  /**
   * وقت آخر رسالة من العميل نفسه (USER).
   *
   * منه تُحسب نافذة الرد الحرّ (٢٤ ساعة) والعدّاد غير المقروء. lastMessageAt
   * لا يصلح بديلاً: ردّ الوكيل أو الموظف يحرّكه، فتبدو النافذة مفتوحة وهي
   * مغلقة عند Meta — والنتيجة رسالة ترفضها Meta بعد أن كتبها الموظف.
   */
  lastInboundAt DateTime?

  /**
   * يتحرّك مع أي تغيير في المحادثة، لا مع الرسائل وحدها.
   *
   * بصمة الصندوق (`version`) كانت من آخر رسالة فقط، فاستلام زميلٍ محادثةً أو
   * إعادتها للوكيل لا يغيّرها — يبقى جوال الموظف الآخر يعرضها «تنتظرك»
   * فيردّ عليها اثنان. التحويل حدثٌ بلا رسالة، فيحتاج علامة غير الرسالة.
   */
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([tenantId, channel, externalUserId])
  @@index([tenantId, status, lastMessageAt])
  @@index([tenantId, channel, lastMessageAt])
  @@index([tenantId, updatedAt])
}

/**
 * آخر قراءة لكل مستخدم في كل محادثة.
 *
 * لكل مستخدم لا لكل محادثة: قراءة موظف لا يجب أن تُخفي العدّاد عن زميله،
 * وإلا ظن الثاني أن أحداً ردّ والمحادثة في الحقيقة معلّقة.
 */
model ConversationRead {
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tenantId       String
  lastReadAt     DateTime

  @@id([userId, conversationId])
  @@index([tenantId])
  @@index([conversationId])
}

model Message {
  id             String       @id @default(cuid())
  tenantId       String
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role MessageRole
  text String      @db.Text

  externalId String? // معرّف الرسالة عند Meta — لمنع المعالجة المكرّرة
  toolCalls  Json? // ما استدعاه الوكيل خلال هذا الرد (للتدقيق)
  usage      Json? // { input_tokens, output_tokens, cache_read_input_tokens }

  /**
   * معرّف يولّده الجوال لكل إرسال، يُعاد معها في الرد.
   *
   * به يطابق التطبيق فقاعة «جارٍ الإرسال» بالرسالة حين تصل في القائمة.
   * أما منع الإرسال المكرّر فمسؤولية OutboundRequest لا هذا الحقل: الرسالة
   * تُخزَّن بعد Meta، فقيد هنا وحده يأتي متأخراً عن الإرسال الثاني.
   */
  clientId String?

  createdAt DateTime @default(now())

  // الحجز الذي أُرسلت به — فارغ لما لم يمر بحجز (الوكيل، الوارد، اللوحة)
  outboundRequest OutboundRequest?

  @@unique([tenantId, externalId])
  @@unique([tenantId, clientId])
  @@index([conversationId, createdAt])
  @@index([tenantId, createdAt])
}

enum OutboundState {
  PENDING // محجوز، والطلب لـ Meta جارٍ
  SENT // قبلتها Meta وخُزّنت
  UNKNOWN // لم تؤكّد Meta ولم ترفض — ربما وصلت، فلا تُعاد أبداً
  FAILED // رفضتها Meta صراحةً — لم تصل، والإعادة بنفس المعرّف مسموحة
}

/**
 * حجز إرسال من الجوال بمعرّف يولّده الجهاز (clientId).
 *
 * يُكتب *قبل* نداء Meta. قيد التفرّد هو ما يمنع طلبين متزامنين بنفس المعرّف
 * من الوصول لـ Meta معاً — فحص «هل أُرسلت؟» ثم إرسال يتركهما يمرّان معاً.
 * انظر src/lib/reservation.ts وجدول الحالات في docs/mobile-api.md.
 */
model OutboundRequest {
  id       String @id @default(cuid())
  tenantId String
  clientId String

  // sha256 للعملية (نوعها، المستلم، النص أو القالب) — نفس المعرّف لعملية
  // أخرى خطأ في الجهاز لا إعادة محاولة
  fingerprint String
  state       OutboundState @default(PENDING)

  messageId String?  @unique
  message   Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, clientId])
}

// ═══════════════════════════════════════════════════════════
//  العملاء المحتملون (يلتقطهم الوكيل أثناء المحادثة)
// ═══════════════════════════════════════════════════════════

model Lead {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name           String?
  phone          String?
  channel        Channel
  externalUserId String?
  interest       String  @db.Text
  notes          String? @db.Text

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

// ═══════════════════════════════════════════════════════════
//  المواعيد — لكل نشاط يعمل بالمواعيد (docs/appointments.md)
// ═══════════════════════════════════════════════════════════

enum AppointmentStatus {
  BOOKED
  CONFIRMED
  IN_PROGRESS
  DONE
  CANCELLED
  NO_SHOW
}

enum AppointmentSource {
  WHATSAPP
  INSTAGRAM
  MESSENGER
  WALK_IN
  PHONE
  DASHBOARD
  APP
}

model Service {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name     String
  category String?
  priceMin Decimal  @db.Decimal(10, 2)
  priceMax Decimal? @db.Decimal(10, 2) // null ⇒ سعر ثابت = priceMin

  // المدة حين لا تاريخ للعميل ولا لمقدّم الخدمة — المقدِّر يتجاوزها حين يتعلّم
  defaultMinutes Int

  /**
   * وقت انتظار داخل الخدمة (صبغة تثبت، تخدير يسري، طلاء يجف): مقدّم
   * الخدمة حرّ خلاله. اختياري — 0 ⇒ لا انتظار. بدونه يُحسب الموعد كله
   * انشغالاً، فيضيع نصف ساعة ينتظر فيها العميل ومقدّم الخدمة بلا عمل.
   */
  processingAfterMinutes Int @default(0) // بعد كم دقيقة من البدء يبدأ الانتظار
  processingMinutes      Int @default(0) // طول الانتظار؛ 0 ⇒ لا انتظار

  rebookAfterDays Int? // تذكير العودة؛ null ⇒ لا تذكير

  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  staff        StaffService[]
  appointments Appointment[]

  @@index([tenantId, active, sortOrder])
}

model Staff {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name  String
  phone String?

  // صورة مصغّرة ≤ 150KB، تُخدم من مسار مخبّأ. photoEtag يُحسب عند الرفع
  // كي تبني القائمة رابطاً بنسخة دون قراءة بايتات كل صورة.
  photo     Bytes?
  photoMime String?
  photoEtag String?

  // { "sat": [["10:00","14:00"],["16:00","21:00"]], "fri": [], … } بتوقيت المتجر
  workingHours      Json
  commissionPercent Decimal? @db.Decimal(5, 2)

  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  services       StaffService[]
  appointments   Appointment[]
  preferredBy    Customer[]

  @@index([tenantId, active, sortOrder])
}

model StaffService {
  staffId   String
  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
  @@index([serviceId])
}

model Customer {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  phone String? // أرقام فقط بمفتاح الدولة
  name  String?
  notes String? @db.Text // ملاحظات دائمة (حساسية، تفضيلات)

  preferredStaffId String?
  preferredStaff   Staff?  @relation(fields: [preferredStaffId], references: [id], onDelete: SetNull)

  visitCount  Int       @default(0)
  noShowCount Int       @default(0)
  lastVisitAt DateTime?
  createdAt   DateTime  @default(now())

  contacts     CustomerContact[]
  appointments Appointment[]

  @@unique([tenantId, phone])
  @@index([tenantId, name])
}

/// ربط العميل بقنواته — واتساب يعطي الرقم، انستقرام وماسنجر معرّفاً فقط.
model CustomerContact {
  id         String   @id @default(cuid())
  tenantId   String
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  channel        Channel
  externalUserId String

  @@unique([tenantId, channel, externalUserId])
  @@index([customerId])
}

model Appointment {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Restrict: حذف عميل أو مقدّم خدمة أو خدمة لا يمحو سجلّ ما حدث — منه يتعلّم
  // المقدِّر وتُحسب العمولة. الإيقاف عبر active لا الحذف.
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  staffId    String
  staff      Staff    @relation(fields: [staffId], references: [id], onDelete: Restrict)
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  startAt        DateTime
  plannedMinutes Int // ما حجزناه — من مُقدِّر المدة لا من الخدمة
  status         AppointmentStatus @default(BOOKED)
  source         AppointmentSource

  startedAt     DateTime?
  finishedAt    DateTime?
  actualMinutes Int? // finishedAt - startedAt، مقرّبة — مادة المقدِّر
  finalPrice    Decimal?  @db.Decimal(10, 2)
  notes         String?   @db.Text // ملاحظات الزيارة: رقم صبغة، دواء، قطعة غيار…

  confirmedAt     DateTime?
  reminderSentAt  DateTime?
  delayNotifiedAt DateTime?
  rebookSentAt    DateTime?
  cancelledAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, staffId, startAt])
  @@index([tenantId, customerId, startAt])
  @@index([tenantId, status, startAt])
  @@index([serviceId, staffId, status])
}
