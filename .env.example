# ---- قاعدة البيانات (Supabase) ----
# من لوحة Supabase: زر Connect ← تبويب ORMs ← Prisma
# DATABASE_URL عبر الـ pooler (منفذ 6543)، DIRECT_URL اتصال مباشر (منفذ 5432)
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ---- المزوّد النشط ----
# anthropic = الإنتاج (جودة عربية عالية + كاش)  |  groq = تجربة مجانية
AGENT_PROVIDER="anthropic"

# ---- Claude API (الإنتاج) ----
ANTHROPIC_API_KEY="sk-ant-..."

# ---- Groq (تجربة مجانية) ----
# المفتاح من: https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
# اختيارية — لها افتراضيات في الكود (تفريغ الفويس ونطقه)
# GROQ_STT_MODEL=""
# GROQ_TTS_MODEL=""
# GROQ_TTS_VOICE=""

# ---- تشفير مفاتيح القنوات المخزنة بقاعدة البيانات ----
# ولّده بـ: openssl rand -hex 32
ENCRYPTION_KEY=""

# ---- Meta (واتساب / ماسنجر / انستقرام) ----
# هذي القيم الافتراضية على مستوى المنصة؛ كل عميل يقدر يتجاوزها بقيمه الخاصة
META_APP_SECRET=""
# نص تختاره أنت ويُكتب نفسه في Meta ← Webhooks ← Verify token
META_VERIFY_TOKEN=""
META_GRAPH_VERSION="v21.0"

# ---- عام ----
APP_BASE_URL="http://localhost:3000"

# ---- كلمة سر لوحة التحكم ----
ADMIN_PASSWORD=""

# ---- إشعارات الجوال (Firebase Cloud Messaging) ----
# ملف حساب الخدمة كاملاً كنص JSON في سطر واحد.
# من Firebase Console: ⚙️ Project settings ← تبويب Service accounts ←
# زر Generate new private key — ثم الصق محتوى الملف هنا.
# فارغ ⇒ لا إشعارات، والتطبيق يعتمد على الاستطلاع كل ٨ ثوانٍ.
FCM_SERVICE_ACCOUNT=

# ---- مهام المواعيد المجدولة (وحدة المواعيد) ----
# سرّ يحمي /api/cron/appointments — بدونه لا تعمل المهمة إطلاقاً.
# ولّده بـ: openssl rand -hex 32  ثم أضفه في Vercel:
#   Project → Settings → Environment Variables → CRON_SECRET
# Vercel ينادي المهمة مرة يومياً (vercel.json: 16:00 UTC = 19:00 عمّان) ويضع
# الرأس Authorization تلقائياً. التذكير والغياب والعودة تكفيها مرة يومياً.
#
# التأخير المتسلسل يحتاج فحصاً كل ٥ دقائق — Vercel Hobby لا يسمح، فمن cron-job.org (مجاني):
#   1. Create cronjob
#   2. URL:  https://<النطاق>/api/cron/appointments
#   3. Execution schedule: Every 5 minutes
#   4. Advanced → Request method: POST
#   5. Advanced → Headers → Add: Authorization = Bearer <قيمة CRON_SECRET>
#   6. Create
CRON_SECRET=

# ── صوت المكالمات لكل متجر (Vapi) ──
# مساعد واحد في Vapi لكل المتاجر؛ حاضر يختار صوت المتجر لكل مكالمة (api/voice/vapi).
# VAPI_SERVER_SECRET: سرّ تكتبه في Vapi مرتين — ترويسة x-hader-secret على «Server URL»
#   للرقم، ومفتاح «Custom LLM» في Integrations. ولّده: openssl rand -hex 32
VAPI_SERVER_SECRET=
# معرّف المساعد المشترك في Vapi (Assistants ← انسخ ID)
VAPI_ASSISTANT_ID=
# اختياري: لزرّ «اسمع الصوت» في صفحة القنوات (Text to Speech فقط)
ELEVENLABS_API_KEY=
